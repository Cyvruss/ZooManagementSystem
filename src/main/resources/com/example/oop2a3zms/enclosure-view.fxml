<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="283.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop2a3zms.Controllers.EnclosureController">

   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0"
            BorderPane.alignment="CENTER">
         <children>

            <Button fx:id="addAnimalButton"
                    mnemonicParsing="false"
                    onAction="#onAddAnimalButtonClick"
                    text="Add">
               <font>
                  <Font size="15.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>

            <Button fx:id="deleteButton"
                    mnemonicParsing="false"
                    text="Delete">
               <font>
                  <Font size="15.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>

            <Button fx:id="EncEditAnimalButton"
                    mnemonicParsing="false"
                    onAction="#onEditAnimalButtonClick"
                    text="Edit">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Button>

            <Button fx:id="EncBackButton"
                    mnemonicParsing="false"
                    onAction="#onEncBackButtonClick"
                    text="Back">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Button>

         </children>
      </HBox>
   </bottom>

   <center>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0"
            BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="BOTTOM_CENTER" prefHeight="300.0" prefWidth="154.0">
               <children>

                  <Label fx:id="EncSectionTitleLabel" text="Section Title ">
                     <font>
                        <Font size="25.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="40.0" />
                     </VBox.margin>
                  </Label>

                  <ListView fx:id="EncAnimalsListview"
                            prefHeight="200.0" prefWidth="200.0" />

               </children>
            </VBox>
         </children>
      </HBox>
   </center>

</BorderPane>
