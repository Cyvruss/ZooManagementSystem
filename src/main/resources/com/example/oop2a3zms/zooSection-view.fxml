<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="515.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop2a3zms.Controllers.ZooSectionController">
    <top>
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="SectionNameLabel" text="Zoo Section">
                    <font>
                        <Font size="25.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="30.0" />
                    </VBox.margin>
                </Label>
                <Label fx:id="SectionAnimalCountLabel" text="Total Animals: 0">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <HBox alignment="CENTER" prefHeight="320.0" prefWidth="350.0" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="BOTTOM_CENTER" prefHeight="300.0" prefWidth="220.0" spacing="10.0">
                    <children>
                        <Label text="Enclosures and Subsections">
                            <font>
                                <Font size="16.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <ListView fx:id="SectionComponentsListView" prefHeight="241.0" prefWidth="220.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="SectionAddButton" mnemonicParsing="false" onAction="#onSectionAddButtonClick" text="Add">
                    <HBox.margin>
                        <Insets right="10.0" top="30.0" />
                    </HBox.margin>
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button fx:id="SectionRemoveButton" mnemonicParsing="false" onAction="#onSectionRemoveButtonClick" text="Remove">
                    <HBox.margin>
                        <Insets left="10.0" right="10.0" top="30.0" />
                    </HBox.margin>
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button fx:id="SectionOpenButton" mnemonicParsing="false" onAction="#onSectionOpenButtonClick" text="Open">
                    <HBox.margin>
                        <Insets left="10.0" right="10.0" top="30.0" />
                    </HBox.margin>
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button fx:id="SectionBackButton" mnemonicParsing="false" onAction="#onSectionBackButtonClick" text="Back">
                    <HBox.margin>
                        <Insets left="10.0" top="30.0" />
                    </HBox.margin>
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </bottom>
</BorderPane>
