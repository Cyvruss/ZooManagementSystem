<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop2a3zms.Controllers.AnimalController"
            prefWidth="500" prefHeight="350"
            style="-fx-background-color: white;">

    <top>
        <VBox spacing="8" alignment="CENTER">
            <padding>
                <Insets top="25" bottom="15"/>
            </padding>

            <Label text="Animal"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding>
                <Insets left="50" right="50"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Name:"
                       prefWidth="70"
                       style="-fx-font-size: 16px;"/>

                <TextField fx:id="aNameTextField"
                           promptText="Enter animal name"
                           prefWidth="250"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Age:"
                       prefWidth="70"
                       style="-fx-font-size: 16px;"/>

                <TextField fx:id="aAgeTextField"
                           promptText="Enter animal age"
                           prefWidth="250"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="20" bottom="25"/>
            </padding>

            <Button text="Cancel"
                    onAction="#onCancelClick"
                    prefWidth="100"/>

            <Button text="Save"
                    onAction="#onSaveClick"
                    prefWidth="100"/>
        </HBox>
    </bottom>

</BorderPane>
